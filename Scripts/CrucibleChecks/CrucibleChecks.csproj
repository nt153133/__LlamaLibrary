<Project Sdk="Microsoft.NET.Sdk">
  <!-- Link production decoders while keeping test doubles out of RB's recursive .cs loader. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.csx" />
    <Compile Include="../../RemoteWindows/CrucibleWindow.cs" />
    <Compile Include="../../RemoteWindows/WindowSnapshot.cs" />
    <Compile Include="../../RemoteWindows/DialogWindow.cs" />
    <Compile Include="../../RemoteWindows/XBM*.cs" />
    <Compile Include="../../Helpers/BeastmasterProgressDecoder.cs" />
    <Compile Include="../../Structs/BeastmasterProgress.cs" />
  </ItemGroup>
</Project>